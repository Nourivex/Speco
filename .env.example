# ==============================================================================
# SPECO FRONTEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Salin file ini menjadi .env.local (untuk pengembangan lokal)
# atau masukkan variabel ini ke dashboard Vercel / hosting (Environment Variables).
# ==============================================================================

# URL API Backend Laravel:
# - Saat lokal: https://carispek-backend.ddev.site atau http://localhost:8000
# - Saat hosting/production: https://api-speco.nour.web.id (atau domain backend Mas Affif)
NEXT_PUBLIC_API_URL=https://carispek-backend.ddev.site

# URL Domain Publik Frontend Speco
NEXT_PUBLIC_SITE_URL=https://speco.nour.web.id

# Status Mock Fallback:
# Jika backend offline atau tidak terjangkau, frontend secara otomatis
# beralih ke data lokal tanpa merusak tampilan antarmuka pengguna.
